.godot/
build/

# Local intermediate art backups — not project assets
assets/cards/_backups/
assets/ui/cards/_backups/

# Concept-art exploration + bug screenshots (scratch)
assets/ui/cards/concepts/
screenshots/

# Root-level art generation previews (scratch)
/tmp_*.png
/tmp_*.png.import
/tmp_*/

# Art-generation scratch / preview dir
/tmp/

# VFX pixel-probe snapshots (regenerable scratch — see tests/_vfx_probe.gd)
/_probe_out/

# UI render-harness output images (regenerable scratch — see dev/_render.gd / dev/_render.tscn).
# The harness scripts live in dev/ and write their PNGs beside themselves; every ad-hoc probe
# adds another one, so ignore the whole class rather than naming each (12 were removed in
# 8c390c7 back when they landed at the repo root).
/dev/*.png
/dev/*.png.import

# Legacy root-level harness output (kept so a stale script writing to res:// still stays out).
/_*.png
/_*.png.import

# Icon rasterization / contact-sheet build output (regenerable scratch)
tools/_icon_preview/

# Editor temp files
*~
.aider*

# Python bytecode cache (tools/*.py)
__pycache__/

# Krita autosave / scratch files (keep real .kra sources if ever added)
*-autosave.kra
.~lock.*

# Local launch config (debug mode switch, seeded by DebugConfig) - per-machine, never committed
/debug.json

# Combat log dumps (see scripts/combat_log.gd) - per-session scratch, never committed
/debugLogs/
